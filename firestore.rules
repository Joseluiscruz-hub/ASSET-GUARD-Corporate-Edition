rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: assets
    // Fields: id, brand, model, serial, fuelType, status, statusSince, location, critical, operatingHours, cleanlinessStatus, lastSanitization
    //
    // Collection: failureReports
    // Fields: id, assetId, entryDate, exitDate, failureDescription, diagnosis, partsUsed, estimatedCost, technician, type
    //
    // Collection: activeFailures
    // Fields: id, economico, falla, reporta, fechaIngreso, fechaSalida, prioridad, estatus, seguimiento, ordenCompra, estatusRefaccion, fechaPromesa
    //
    // Collection: maintenanceSchedule
    // Fields: id, model, serial, economico, supervisor, smpType, scheduledDate, realDate, duration, otFolio, serviceOrder, hourMeter, technician, status, history, comments
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "mimonkb222@gmail.com" && request.auth.token.email_verified == true));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidString(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) && (request.resource.data.role in ['user', 'viewer', 'admin']);
      allow update: if isAuthenticated() && (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role));
    }

    match /assets/{assetId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /failureReports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /activeFailures/{failureId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /maintenanceSchedule/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
