{
  "rules": {
    "failures": {
      ".read": true,
      ".write": true,
      "$failureId": {
        ".validate": "newData.hasChildren(['economico', 'falla', 'estatus', 'fechaIngreso'])",
        "economico": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "falla": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "prioridad": {
          ".validate": "newData.val() === 'Alta' || newData.val() === 'Media' || newData.val() === 'Baja'"
        },
        "estatus": {
          ".validate": "newData.val() === 'Abierta' || newData.val() === 'En Proceso' || newData.val() === 'Cerrada'"
        },
        "estatusRefaccion": {
          ".validate": "!newData.exists() || newData.val() === 'N/A' || newData.val() === 'En Stock' || newData.val() === 'Pedida' || newData.val() === 'Por Recibir'"
        },
        "fechaIngreso": {
          ".validate": "newData.isString()"
        },
        "seguimiento": {
          "$msgId": {
            ".validate": "newData.hasChildren(['usuario', 'mensaje', 'fecha'])",
            "usuario": {
              ".validate": "newData.isString()"
            },
            "mensaje": {
              ".validate": "newData.isString()"
            }
          }
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "settings": {
      ".read": true,
      ".write": true,
      "kioskMode": {
        ".validate": "newData.isBoolean()"
      },
      "$other": {
        ".validate": true
      }
    }
  }
}